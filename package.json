{
  "name": "hantavirus-cruise-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static tracker for the Hantavirus cruise outbreak. Astro + GitHub Pages, refreshed by a GitHub Actions cron.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "scrape": "tsx scripts/scrape/run.ts",
    "scrape:dry": "tsx scripts/scrape/run.ts --dry",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.astro,.tsx,.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/sitemap": "^3.2.1",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.1.1",
    "fast-xml-parser": "^4.5.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.15.0"
}
