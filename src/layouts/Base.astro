---
import "~/styles/global.css";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import JsonLd from "~/components/JsonLd.astro";
import Analytics from "@vercel/analytics/astro";
import { stats } from "~/data";
import { websiteJsonLd, organizationJsonLd, outbreakJsonLd, breadcrumbsJsonLd } from "~/lib/seo";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Optional page-specific structured-data payload(s) merged with site defaults. */
  structuredData?: unknown[];
  /** Override og:type, e.g. "article" for content pages. */
  ogType?: "website" | "article";
  /** Optional last-mod hint used in <meta property="article:modified_time">. */
  modifiedTime?: string;
  /** Breadcrumb trail; the home crumb is added automatically. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  current,
  structuredData = [],
  ogType = "website",
  modifiedTime,
  breadcrumbs,
} = Astro.props as Props;

const fullTitle = title
  ? `${title} — Hantavirus Cruise Tracker`
  : "Hantavirus Cruise Tracker — MV Hondius outbreak monitoring";

const desc =
  description ??
  `Independent, source-linked tracker of the ${stats.outbreak.name}. Timeline, case counts, advisories, and updates from CDC, WHO, ECDC, Oceanwide Expeditions, and major newsrooms.`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const origin = new URL(Astro.url.pathname, Astro.site).origin;
const ogImage = new URL("/og.svg", Astro.site).toString();

const baseStructured: unknown[] = [
  websiteJsonLd({ origin }),
  organizationJsonLd({ origin }),
  outbreakJsonLd({ origin }),
];

if (breadcrumbs && breadcrumbs.length > 0) {
  baseStructured.push(
    breadcrumbsJsonLd({ origin }, [{ name: "Home", path: "/" }, ...breadcrumbs]),
  );
}

const allStructured = [...baseStructured, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S92DLHY9RL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-S92DLHY9RL");
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1012" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="application-name" content="Hantavirus Cruise Tracker" />
    <meta name="description" content={desc} />
    <meta
      name="keywords"
      content="hantavirus, MV Hondius, Oceanwide Expeditions, Andes virus, ANDV, cruise outbreak, hantavirus cruise, Cape Verde, Tenerife, Canary Islands, Ushuaia, expedition cruise, outbreak tracker, CDC, WHO, ECDC"
    />
    <meta name="author" content="Hantavirus Cruise Tracker" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Hantavirus Cruise Tracker" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hantavirus Cruise Tracker — MV Hondius" />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons + manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Latest sources" href="/rss.xml" />
    <link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <JsonLd data={allStructured} />

    <script is:inline>
      // Apply stored theme before paint to avoid flash.
      try {
        const t = localStorage.getItem("hcv-theme");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch {}
    </script>
  </head>
  <body>
    <SiteHeader current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
