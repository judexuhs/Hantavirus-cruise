---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  current?: string;
}

const { current } = Astro.props as Props;

const nav: { href: string; label: string; id: string }[] = [
  { href: "/", label: "Overview", id: "home" },
  { href: "/timeline/", label: "Timeline", id: "timeline" },
  { href: "/cases/", label: "Cases", id: "cases" },
  { href: "/cruise/", label: "Cruise", id: "cruise" },
  { href: "/sources/", label: "Sources", id: "sources" },
  { href: "/guide/", label: "Guide", id: "guide" },
  { href: "/faq/", label: "FAQ", id: "faq" },
];

const baseUrl = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}${path}`;
};
---

<header class="site-header">
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="container header-inner">
    <a class="brand" href={baseUrl("/")}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-title">Hantavirus Cruise Tracker</span>
        <span class="brand-subtitle subtle">Independent, source-linked monitoring</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={baseUrl(item.href)}
                aria-current={current === item.id ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="meta-cluster">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--c-border);
  }
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-5);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--c-fg);
  }
  .brand:hover {
    color: var(--c-fg);
  }
  .brand-mark {
    width: 14px;
    height: 14px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-accent) 18%, transparent);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-md);
  }
  .brand-subtitle {
    font-size: var(--fs-xs);
  }
  .primary-nav ul {
    list-style: none;
    display: flex;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .primary-nav a {
    color: var(--c-fg-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
    padding: var(--sp-2) 0;
    border-bottom: 2px solid transparent;
  }
  .primary-nav a:hover {
    color: var(--c-fg);
  }
  .primary-nav a[aria-current="page"] {
    color: var(--c-fg);
    border-bottom-color: var(--c-accent);
  }
  .meta-cluster {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
  }
  @media (max-width: 1024px) {
    .header-inner {
      grid-template-columns: auto auto;
      grid-template-rows: auto auto;
      row-gap: var(--sp-2);
    }
    .meta-cluster {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
    }
    .primary-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--sp-5));
      padding-inline: var(--sp-5);
    }
    .primary-nav ul {
      justify-content: flex-start;
      white-space: nowrap;
    }
    .brand-subtitle {
      display: none;
    }
  }
</style>
