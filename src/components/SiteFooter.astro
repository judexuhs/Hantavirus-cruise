---
const baseUrl = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}${path}`;
};
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="col">
      <h4>About this site</h4>
      <p class="muted">
        An independent, fact-first tracker of the Hantavirus cruise outbreak. Every claim links to
        its primary source. We surface official health-agency notices first, mainstream news
        second, and clearly-labeled social signals last.
      </p>
    </div>

    <div class="col">
      <h4>Browse</h4>
      <ul class="links">
        <li><a href={baseUrl("/")}>Overview</a></li>
        <li><a href={baseUrl("/timeline/")}>Timeline</a></li>
        <li><a href={baseUrl("/cases/")}>Cases and stats</a></li>
        <li><a href={baseUrl("/cruise/")}>Cruise and route</a></li>
        <li><a href={baseUrl("/sources/")}>Sources</a></li>
        <li><a href={baseUrl("/about/")}>About hantavirus</a></li>
        <li><a href={baseUrl("/questions/")}>Key questions</a></li>
        <li><a href={baseUrl("/glossary/")}>Glossary</a></li>
        <li><a href={baseUrl("/advisories/")}>Official advisories</a></li>
        <li><a href={baseUrl("/faq/")}>FAQ</a></li>
        <li><a href={baseUrl("/terms/")}>Terms of Service</a></li>
        <li><a href={baseUrl("/privacy/")}>Privacy Policy</a></li>
      </ul>
      <p class="subtle small">
        Not affiliated with any health authority or cruise operator. Information is provided
        without warranty; consult official sources before making travel or medical decisions.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    background: var(--c-bg-sunk);
    padding-block: var(--sp-7);
    margin-top: var(--sp-8);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-7);
  }
  h4 {
    font-size: var(--fs-sm);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-fg-muted);
    margin-bottom: var(--sp-3);
  }
  .col p {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-sm);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-sm);
  }
  .links li {
    margin-bottom: var(--sp-2);
  }
  .small {
    font-size: var(--fs-xs);
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }
</style>
