---
const baseUrl = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}${path}`;
};
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="col">
      <h4>About this site</h4>
      <p class="muted">
        An independent, fact-first tracker of the Hantavirus cruise outbreak. Every claim links to
        its primary source. We surface official health-agency notices first, mainstream news second,
        and clearly-labeled social signals last.
      </p>
    </div>

    <div class="col">
      <h4>Browse</h4>
      <ul class="links">
        <li><a href={baseUrl("/")}>Overview</a></li>
        <li><a href={baseUrl("/hantavirus-tracker/")}>Hantavirus tracker</a></li>
        <li><a href={baseUrl("/ship-tracker/")}>MV Hondius live tracker</a></li>
        <li>
          <a href={baseUrl("/mv-hondius-current-status-tenerife-arrival-may-2026/")}
            >MV Hondius Tenerife status</a
          >
        </li>
        <li><a href={baseUrl("/timeline/")}>Timeline</a></li>
        <li><a href={baseUrl("/cases/")}>Cases and stats</a></li>
        <li><a href={baseUrl("/cruise/")}>Cruise and route</a></li>
        <li><a href={baseUrl("/sources/")}>Sources</a></li>
        <li><a href={baseUrl("/guide/")}>Guide</a></li>
        <li><a href={baseUrl("/terms/")}>Terms of Service</a></li>
        <li><a href={baseUrl("/privacy/")}>Privacy Policy</a></li>
      </ul>
      <p class="subtle small">
        Not affiliated with any health authority or cruise operator. Information is provided without
        warranty; consult official sources before making travel or medical decisions.
      </p>
    </div>
  </div>
  <div class="footer-badges" aria-label="Featured listings">
    <a href="https://twelve.tools" target="_blank" rel="noopener">
      <img
        src="https://twelve.tools/badge1-white.svg"
        alt="Featured on Twelve Tools"
        width="200"
        height="54"
        loading="lazy"
      />
    </a>
    <a href="https://wired.business" target="_blank" rel="noopener">
      <img
        src="https://wired.business/badge1-white.svg"
        alt="Featured on Wired Business"
        width="200"
        height="54"
        loading="lazy"
      />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    background: var(--c-bg-sunk);
    padding-block: var(--sp-7);
    margin-top: var(--sp-8);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-7);
  }
  h4 {
    font-size: var(--fs-sm);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-fg-muted);
    margin-bottom: var(--sp-3);
  }
  .col p {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-sm);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-sm);
  }
  .links li {
    margin-bottom: var(--sp-2);
  }
  .small {
    font-size: var(--fs-xs);
  }
  .footer-badges {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-6);
    opacity: 0.42;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .footer-badges:hover,
  .footer-badges:focus-within {
    opacity: 0.72;
  }
  .footer-badges a {
    display: inline-flex;
  }
  .footer-badges img {
    display: block;
    width: 160px;
    height: auto;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }
</style>
