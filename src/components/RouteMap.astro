---
import type { PortStop } from "~/data";
import { formatDate } from "~/lib/format";

interface Props {
  ports: PortStop[];
}

const { ports } = Astro.props as Props;

const known = ports.filter(
  (p): p is PortStop & { lat: number; lon: number } => p.lat !== null && p.lon !== null,
);

const routePoints = known.map((p, i) => ({
  name: p.name,
  country: p.country,
  lat: p.lat,
  lon: p.lon,
  arrival: p.arrival,
  departure: p.departure,
  note: p.note,
  isCurrent: i === known.length - 1,
}));

const overlayW = 1000;
const overlayH = 460;
const mercatorY = (lat: number) => {
  const rad = (lat * Math.PI) / 180;
  const value = Math.log(Math.tan(Math.PI / 4 + rad / 2));
  return (1 - value / Math.PI) / 2;
};
const overlayPoints = known.map((p) => ({
  x: ((p.lon + 180) / 360) * overlayW,
  y: mercatorY(p.lat) * overlayH,
  name: p.name,
}));
---

{
  known.length === 0 ? (
    <div class="empty-map">
      <p class="muted">
        Ports of call are not yet confirmed. The route map renders once coordinates are added to{" "}
        <code>src/data/cruise.json</code>.
      </p>
    </div>
  ) : (
    <figure class="route-map">
      <div class="map-head">
        <h3>Itinerary</h3>
        <span>OSM · grayscale</span>
      </div>
      <div
        id="route-map"
        class="leaflet-route-map"
        aria-label="Approximate MV Hondius itinerary map"
      >
        <svg
          class="route-overlay"
          viewBox={`0 0 ${overlayW} ${overlayH}`}
          role="img"
          aria-label="MV Hondius route from Ushuaia to Tenerife"
        >
          <polyline
            points={overlayPoints.map((p) => `${p.x},${p.y}`).join(" ")}
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-dasharray="10 10"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          {overlayPoints.map((p, i) => (
            <g>
              <circle
                cx={p.x}
                cy={p.y}
                r={i === overlayPoints.length - 1 ? 9 : 8}
                fill={i === overlayPoints.length - 1 ? "currentColor" : "var(--c-bg)"}
                stroke="currentColor"
                stroke-width="3"
              />
              {(i === 0 || i === 6 || i === overlayPoints.length - 1) && (
                <text x={p.x + 12} y={p.y - 10}>
                  {p.name.replace(" (anchored offshore)", "").replace(" anchorage (planned)", "")}
                </text>
              )}
            </g>
          ))}
        </svg>
      </div>
      <script
        id="route-map-data"
        type="application/json"
        set:html={JSON.stringify(routePoints)}
        is:inline
      />
      <figcaption class="subtle">
        Approximate itinerary based on reported ports of call. This is not live AIS tracking or
        navigational data.
      </figcaption>

      <ol class="port-list">
        {ports.map((p, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <div class="port-name">
                {p.name}
                <span class="subtle"> · {p.country}</span>
              </div>
              <div class="port-times subtle">
                {p.arrival ? `Arr ${formatDate(p.arrival)}` : "Arrival TBD"}
                {p.departure ? ` · Dep ${formatDate(p.departure)}` : ""}
              </div>
              {p.note && <div class="port-note subtle">{p.note}</div>}
            </div>
          </li>
        ))}
      </ol>
    </figure>
  )
}

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
  is:inline></script>

<script is:inline>
  (() => {
    function initRouteMap() {
      const el = document.getElementById("route-map");
      const data = document.getElementById("route-map-data");
      if (!el || !data || !window.L || el.dataset.initialized === "true") return;

      let points = [];
      try {
        points = JSON.parse(data.textContent || "[]");
      } catch (err) {
        console.error("Route map data could not be parsed", err);
      }
      if (points.length === 0) return;

      el.dataset.initialized = "true";

      const map = window.L.map(el, {
        zoomControl: true,
        scrollWheelZoom: false,
        attributionControl: true,
        worldCopyJump: true,
      });

      window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 7,
        minZoom: 2,
        attribution: "&copy; OpenStreetMap contributors",
        className: "grayscale-tiles",
      }).addTo(map);

      const latLngs = points.map((p) => [p.lat, p.lon]);

      window.L.polyline(latLngs, {
        color: "#111",
        weight: 4,
        opacity: 0.95,
        dashArray: "8 8",
        lineJoin: "round",
        pane: "overlayPane",
      }).addTo(map);

      points.forEach((p, i) => {
        const marker = window.L.circleMarker([p.lat, p.lon], {
          radius: p.isCurrent ? 9 : 8,
          color: "#111",
          weight: 3,
          fillColor: p.isCurrent ? "#111" : "#fff",
          fillOpacity: 1,
          pane: "markerPane",
        }).addTo(map);

        const dates = [
          p.arrival
            ? `Arr ${new Date(p.arrival).toLocaleDateString("en", { month: "short", day: "numeric" })}`
            : "",
          p.departure
            ? `Dep ${new Date(p.departure).toLocaleDateString("en", { month: "short", day: "numeric" })}`
            : "",
        ]
          .filter(Boolean)
          .join(" · ");

        marker.bindPopup(
          `<strong>${i + 1}. ${p.name}</strong><br>${p.country}${dates ? `<br>${dates}` : ""}`,
        );
      });

      map.setView([0, 0], 2);
      window.setTimeout(() => map.invalidateSize(), 0);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRouteMap);
    } else {
      initRouteMap();
    }
  })();
</script>

<style>
  .route-map {
    margin: 0;
  }
  .map-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-3);
  }
  .map-head h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .map-head span {
    color: var(--c-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .leaflet-route-map {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 460px;
    min-height: 460px;
    border: 2px solid var(--c-fg);
    border-radius: 0;
    background: var(--c-bg-sunk);
  }
  .route-overlay {
    position: absolute;
    inset: 0;
    z-index: 650;
    width: 100%;
    height: 100%;
    color: #111;
    pointer-events: none;
  }
  .route-overlay text {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    fill: currentColor;
    stroke: var(--c-bg);
    stroke-width: 5px;
    paint-order: stroke;
  }
  .leaflet-route-map :global(.leaflet-pane),
  .leaflet-route-map :global(.leaflet-tile),
  .leaflet-route-map :global(.leaflet-marker-icon),
  .leaflet-route-map :global(.leaflet-marker-shadow),
  .leaflet-route-map :global(.leaflet-tile-container),
  .leaflet-route-map :global(.leaflet-pane > svg),
  .leaflet-route-map :global(.leaflet-pane > canvas),
  .leaflet-route-map :global(.leaflet-zoom-box),
  .leaflet-route-map :global(.leaflet-image-layer),
  .leaflet-route-map :global(.leaflet-layer) {
    position: absolute;
    left: 0;
    top: 0;
  }
  .leaflet-route-map :global(.leaflet-container) {
    overflow: hidden;
  }
  .leaflet-route-map :global(.leaflet-control) {
    position: relative;
    z-index: 800;
    pointer-events: visiblePainted;
    pointer-events: auto;
  }
  .leaflet-route-map :global(.grayscale-tiles) {
    filter: grayscale(1) contrast(0.9) brightness(1.08);
  }
  .leaflet-route-map :global(.leaflet-control-zoom a) {
    color: #111;
    text-decoration: none;
  }
  .leaflet-route-map :global(.leaflet-popup-content-wrapper) {
    border-radius: 0;
    border: 1px solid #111;
    box-shadow: none;
    font-family: var(--font-sans);
  }
  figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
  }
  .empty-map {
    padding: var(--sp-6);
    border: 1px dashed var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-bg-sunk);
  }
  .port-list {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  .port-list li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-bg-elev);
  }
  .num {
    font-family: var(--font-mono);
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }
  .port-name {
    font-weight: 500;
  }
  .port-times {
    font-size: var(--fs-xs);
    margin-top: var(--sp-1);
  }
  .port-note {
    font-size: var(--fs-xs);
    margin-top: var(--sp-1);
  }
  @media (max-width: 768px) {
    .leaflet-route-map {
      height: 340px;
      min-height: 340px;
    }
    .port-list {
      grid-template-columns: 1fr;
    }
  }
</style>
