---
import Base from "~/layouts/Base.astro";
import TimelineList from "~/components/TimelineList.astro";
import { getCollection } from "astro:content";
import { timelineJsonLd } from "~/lib/seo";

const entries = (await getCollection("timeline")).sort((a, b) =>
  a.data.date.localeCompare(b.data.date),
);
const origin = new URL(Astro.url.pathname, Astro.site).origin;
const structured = [timelineJsonLd({ origin }, entries)];
---

<Base
  title="Timeline"
  description="Chronological log of the MV Hondius hantavirus outbreak from departure in Ushuaia through the planned arrival at Granadilla, Tenerife. Each entry is linked to a primary source."
  current="timeline"
  ogType="article"
  structuredData={structured}
  breadcrumbs={[{ name: "Timeline", path: "/timeline/" }]}
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Outbreak record</p>
      <h1>Timeline</h1>
      <p class="muted lede">
        Every entry is dated, categorized, and where possible linked to a primary source. Items
        marked <em>Pending review</em> are auto-suggested by the source pipeline and have not yet
        been verified by a curator.
      </p>

      <TimelineList showPending={true} />
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 56rem;
  }
  .lede {
    font-size: var(--fs-md);
    max-width: var(--prose-max);
    margin-bottom: var(--sp-6);
  }
</style>
