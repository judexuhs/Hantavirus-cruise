---
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";
import { faqJsonLd } from "~/lib/seo";

const entries = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const structured = [faqJsonLd(entries)];
---

<Base
  title="FAQ"
  description="Answers to common questions from passengers, crew, and the general public about the MV Hondius hantavirus cruise outbreak — risk, transmission, testing, and travel advice."
  current="faq"
  structuredData={structured}
  breadcrumbs={[{ name: "FAQ", path: "/faq/" }]}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Common questions</p>
      <h1>Frequently asked questions</h1>
      <p class="muted lede">
        High-frequency, high-stakes questions answered with citations. If your question isn't
        here, the Sources page is the most up-to-date place to look.
      </p>

      <div class="faq-list prose">
        {
          entries.map(async (entry) => {
            const { Content } = await entry.render();
            return (
              <details class="faq-item" id={entry.id}>
                <summary>
                  <a class="q-link" href={`#${entry.id}`}>{entry.data.question}</a>
                </summary>
                <div class="answer">
                  <Content />
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .lede {
    font-size: var(--fs-md);
    max-width: var(--prose-max);
    margin-bottom: var(--sp-6);
  }
  .faq-list {
    max-width: 56rem;
  }
  .faq-item {
    border-top: 1px solid var(--c-border);
    padding: var(--sp-4) 0;
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--c-border);
  }
  summary {
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-weight: 500;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .q-link {
    color: inherit;
    text-decoration: none;
  }
  .q-link:hover {
    text-decoration: underline;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    font-size: var(--fs-lg);
    color: var(--c-fg-muted);
    transition: transform 0.15s var(--ease);
    line-height: 1;
  }
  .faq-item[open] summary::after {
    content: "−";
  }
  .answer {
    margin-top: var(--sp-3);
    padding-left: 0;
  }
  .answer :global(p) {
    font-size: var(--fs-sm);
    color: var(--c-fg);
  }
</style>
