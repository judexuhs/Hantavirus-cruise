---
import Base from "~/layouts/Base.astro";
import NewsCard from "~/components/NewsCard.astro";
import { getCollection } from "astro:content";
import { newsMeta, stats } from "~/data";
import { formatDateTime } from "~/lib/format";

const all = await getCollection("news");
const items = all
  .map((entry) => entry.data)
  .filter((i) => i.sourceType === "official")
  .filter((i) => ["cdc", "who", "ecdc"].some((t) => i.tags?.includes(t)))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  .slice(0, 60);

const counts = {
  cdc: items.filter((i) => i.tags?.includes("cdc")).length,
  who: items.filter((i) => i.tags?.includes("who")).length,
  ecdc: items.filter((i) => i.tags?.includes("ecdc")).length,
};
---

<Base
  title="Official advisories"
  description={`Official notices and advisories related to the ${stats.outbreak.name}. Aggregated from WHO, CDC, and ECDC when available.`}
  current="advisories"
  ogType="article"
  breadcrumbs={[{ name: "Official advisories", path: "/advisories/" }]}
  modifiedTime={newsMeta.lastRunAt}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Official notices</p>
      <h1>Official advisories</h1>
      <p class="muted lede">
        A curated view of official notices only (WHO, CDC, ECDC). This page is informational and
        does not replace guidance from your local public health authority.
      </p>
      <p class="subtle small">
        Last refreshed <strong>{formatDateTime(newsMeta.lastRunAt)}</strong>. Available in this
        build: CDC {counts.cdc}, WHO {counts.who}, ECDC {counts.ecdc}.
      </p>

      {items.length === 0 ? (
        <p class="muted">
          No official advisories are available in the current dataset. Check the Sources page for
          broader coverage.
        </p>
      ) : (
        <div class="news-grid">
          {items.map((item) => (
            <NewsCard item={item} />
          ))}
        </div>
      )}

      {newsMeta.errors?.length > 0 && (
        <div class="errors">
          <h2>Feed status</h2>
          <p class="muted">
            Some sources may be temporarily unreachable due to upstream changes, rate limits, or
            network restrictions. Errors are shown here for transparency.
          </p>
          <ul class="error-list">
            {newsMeta.errors.map((e) => (
              <li>
                <strong>{e.source}</strong>: <span class="subtle">{e.message}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .lede {
    font-size: var(--fs-md);
    max-width: var(--prose-max);
    margin-bottom: var(--sp-5);
  }
  .small {
    font-size: var(--fs-xs);
    margin-bottom: var(--sp-6);
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .errors {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--c-border);
    max-width: var(--prose-max);
  }
  .error-list {
    padding-left: var(--sp-5);
  }
  .error-list li {
    margin-bottom: var(--sp-2);
  }
  @media (max-width: 1024px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
